# Copy this file to .env and fill in your values. .env is ignored by Git and must never be committed.

# Anthropic API key, used for invoice extraction and line-item matching.
ANTHROPIC_API_KEY=

# Claude model to use.
ANTHROPIC_MODEL=claude-opus-5-5

# The next three are for running the app directly on your machine (python -m app). Under Docker
# Compose they are ignored: docker-compose.yml sets REFERENCE_API_URL=http://api:8000,
# DATA_DIR=/data (the app_data volume) and HOST=0.0.0.0 inside the container.

# Address of the reference API.
REFERENCE_API_URL=http://localhost:8000

# Folder for the app's database and uploaded files.
DATA_DIR=./data

# The address the server listens on; 127.0.0.1 keeps it on this machine.
HOST=127.0.0.1

# Host names the app answers to (blocks DNS-rebinding attacks), as a JSON list.
ALLOWED_HOSTS=["localhost","127.0.0.1"]
