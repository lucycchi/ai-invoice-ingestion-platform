# Copy this file to .env and fill in your values. .env is ignored by Git and must never be committed.

# Anthropic API key, used for invoice extraction and line-item matching.
ANTHROPIC_API_KEY=

# Claude model to use.
ANTHROPIC_MODEL=claude-opus-5-5

# Address of the reference API. Inside Docker Compose use the service name; when running the app
# directly on your machine use http://localhost:8000.
REFERENCE_API_URL=http://api:8000
